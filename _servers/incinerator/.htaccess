Options -Indexes
DirectoryIndex index.php

RewriteEngine On
RewriteRule ^(?:\.incinerator-state|_clean-fixture)(?:/|$) - [F,L,NC]
RewriteRule ^password\.txt$ - [F,L,NC]
RewriteRule ^(?:_incinerator_lib|reset-lab)\.php(?:/|$) - [F,L,NC]
RewriteRule ^(?!(?:index|preview)\.php(?:/|$)|data/).*\.php(?:/|$) - [F,L,NC]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
</IfModule>
